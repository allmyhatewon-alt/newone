# ═══════════════════════════════════════════════════════════════
# pengelus-next — environment variables
# Copy this file to .env.local and fill in every value
# NEVER commit .env.local to git
# ═══════════════════════════════════════════════════════════════

# ── SUPABASE ────────────────────────────────────────────────────
# Where to find: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # NEVER expose this to the client

# ── DATABASE (Prisma) ────────────────────────────────────────────
# Where to find: Supabase → Settings → Database → Connection string
# Use "Transaction" pooler (port 6543) for DATABASE_URL  ← Vercel/serverless
# Use "Session" pooler  (port 5432) for DIRECT_URL       ← prisma migrate
DATABASE_URL="postgresql://postgres.XXXX:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.XXXX:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# ── NEXTAUTH ────────────────────────────────────────────────────
# NEXTAUTH_SECRET: run `openssl rand -base64 32` in your terminal
# NEXTAUTH_URL: your full domain (http://localhost:3000 for dev)
NEXTAUTH_SECRET=your_random_secret_here_run_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ── CLOUDFLARE R2 (MP3 uploads — Gems feature) ──────────────────
# Where to find: dash.cloudflare.com → R2 → your bucket → Manage R2 API Tokens
# Create a bucket called "pengelus-audio" first, then make it public
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=pengelus-audio
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXX.r2.dev   # from bucket Public URL settings

# ── STRIPE (Gems / paid tier) ────────────────────────────────────
# Where to find: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe → Webhooks → your endpoint

# ═══════════════════════════════════════════════════════════════
# VERCEL DEPLOYMENT CHECKLIST:
# 1. Go to vercel.com → your project → Settings → Environment Variables
# 2. Paste EVERY variable above (except the comments)
# 3. For DATABASE_URL use the Transaction pooler (port 6543)
# 4. For DIRECT_URL use the Session pooler (port 5432)
# 5. Set NEXTAUTH_URL to your production domain (https://pengelus.me)
# ═══════════════════════════════════════════════════════════════
