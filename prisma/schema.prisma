generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Transaction pooler (port 6543) — used at runtime / Vercel
  url       = env("DATABASE_URL")
  // Session pooler (port 5432) — used by prisma migrate
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum Role {
  USER
  MOD
  ADMIN
}

enum Currency {
  SHARD
  GEM
  XP
}

enum TransactionType {
  CHECK_IN_REWARD
  STREAK_BONUS
  CLIP_WIN_REWARD
  PURCHASE_GEM
  SPEND_SHARD
  SPEND_GEM
  ADMIN_GRANT
  REFERRAL_BONUS
}

enum ItemType {
  BLOCK
  SKIN
  AURA
  BOOT_SEQ
  BADGE
  MUSIC_PACK
}

enum ItemTier {
  FREE
  SHARD
  GEM
}

enum BlockType {
  TEXT
  IMAGE
  VIDEO_EMBED
  MUSIC_PLAYER
  SOCIAL_LINKS
  PORTAL
  CUSTOM_HTML
  STATS_CARD
  GUESTBOOK
  COUNTDOWN
  SPOTIFY_EMBED
  TIKTOK_FEED
  MP3_UPLOAD
}

// ─────────────────────────────────────────────────────────
// NEXTAUTH ADAPTER TABLES (required exactly as-is)
// ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────
// CORE USER
// ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  displayName   String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?   // null for OAuth-only users
  image         String?
  bio           String?   @db.Text
  accentColor   String    @default("#8a2be2")
  role          Role      @default(USER)

  // Economy — denormalized for O(1) balance reads
  shards        Int       @default(0)
  gems          Int       @default(0)
  xp            Int       @default(0)
  level         Int       @default(1)

  // Streaks
  streakCount   Int       @default(0)
  longestStreak Int       @default(0)
  lastCheckIn   DateTime?

  // Flags
  onboarded     Boolean   @default(false)
  gemsUnlocked  Boolean   @default(false) // true after first gem purchase

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth
  accounts      Account[]
  sessions      Session[]

  // App relations
  hubProfile      HubProfile?
  space           Space?
  inventory       InventoryItem[]
  transactions    Transaction[]
  checkIns        CheckIn[]
  achievements    UserAchievement[]
  uploads         AudioUpload[]
}

// ─────────────────────────────────────────────────────────
// HUB PROFILE — the "Social ID" at /hub/user/@username
// ─────────────────────────────────────────────────────────

model HubProfile {
  id            String  @id @default(cuid())
  userId        String  @unique

  // Portal block settings
  portalEnabled Boolean @default(false)
  portalLabel   String  @default("Enter My Space")

  // Active skin/aura
  activeSkinId  String? // references CatalogItem.slug
  activeAuraId  String? // references CatalogItem.slug

  // Social links displayed on Hub Profile
  tiktokUrl     String?
  twitchUrl     String?
  youtubeUrl    String?
  kickUrl       String?
  discordUser   String?
  twitterUrl    String?
  instagramUrl  String?

  // Display settings
  showStats     Boolean @default(true)
  showStreak    Boolean @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────
// SPACE — the "Personal Domain" at /@username
// Blocks stored as JSON array, schema validated at app layer
// ─────────────────────────────────────────────────────────

model Space {
  id           String  @id @default(cuid())
  userId       String  @unique

  published    Boolean @default(false)
  blocks       Json    @default("[]")
  // Each block: { id, type: BlockType, order, config: {...}, gemsRequired? }

  // Gems-gated features
  customCss    String? @db.Text
  bootSequence String? @db.Text // JS/CSS for boot animation

  // SEO
  metaTitle       String?
  metaDescription String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────
// SHOP CATALOG
// ─────────────────────────────────────────────────────────

model CatalogItem {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?   @db.Text
  type        ItemType
  tier        ItemTier
  price       Int       @default(0)
  previewUrl  String?
  metadata    Json?     // extra config per item type

  createdAt   DateTime  @default(now())

  inventory   InventoryItem[]
}

model InventoryItem {
  id          String    @id @default(cuid())
  userId      String
  itemId      String
  equippedAt  DateTime?

  createdAt   DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        CatalogItem @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────
// ECONOMY LEDGER
// ─────────────────────────────────────────────────────────

model Transaction {
  id        String          @id @default(cuid())
  userId    String
  type      TransactionType
  currency  Currency
  amount    Int
  balance   Int             // balance AFTER this transaction
  metadata  Json?

  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────
// DAILY CHECK-IN
// ─────────────────────────────────────────────────────────

model CheckIn {
  id           String   @id @default(cuid())
  userId       String
  date         String   // "YYYY-MM-DD" — one per day, enforced by @@unique
  streak       Int
  multiplier   Float    @default(1.0)
  shardsEarned Int

  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────
// ACHIEVEMENTS
// ─────────────────────────────────────────────────────────

model Achievement {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  iconEmoji   String  @default("🏆")
  xpReward    Int     @default(0)
  shardReward Int     @default(0)

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
}

// ─────────────────────────────────────────────────────────
// MP3 UPLOADS (Gems feature — stored on R2)
// ─────────────────────────────────────────────────────────

model AudioUpload {
  id        String  @id @default(cuid())
  userId    String
  filename  String
  r2Key     String  @unique
  r2Url     String
  duration  Int?    // seconds
  sizeBytes Int?
  title     String?
  artist    String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
